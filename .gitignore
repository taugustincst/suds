node_modules/
data/
!data/.gitkeep
# npm run try (scripts/try-local.js): SUDS for testing on this computer, with fictional sample data.
/data-try/
.env
*.db
*.db-journal
*.db-wal
*.db-shm
backups/
certs/

# Android release signing. The keystore IS the app's identity: committing it would let anyone publish an
# update county phones would accept, and losing it means staff must uninstall to upgrade.
android-signing/
*.jks
*.keystore
SUDS_KEYSTORE_BASE64.txt

# Build output of scripts/build-static-site.js — generated, published to gh-pages by CI, never committed here.
/_site/

# Provider pictures downloaded by scripts/fetch-region-pictures.js for the static build: other
# organisations' logos and photos, refreshed at each build, never committed (docs/WEB_APP.md).
/_region-pictures/

# deploy/fleet: tenant settings, the register, escrow and credentials live in the private FLEET_HOME, never in this
# repository (every fleet script refuses a FLEET_HOME inside it; this is the second guard). deploy/fleet/README.md.
/deploy/fleet/*.env
/deploy/fleet/*/
/fleet-home/
register/
escrow/
credentials/
*.tar.gpg
*.tenant.env
porkbun*.env
known_hosts
