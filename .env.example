# ---- SUDS configuration (copy to .env) ----
# Optional: the browser setup wizard (docs/INSTALL.md) writes data/server.json and data/keys.json instead.
# Anything set here overrides the wizard.
SUDS_ENV=production
PORT=8443
HOST=0.0.0.0

# 32-byte hex key for AES-256-GCM field encryption of PHI. Generate with: npm run gen-key
# NEVER commit this. Store in a secrets manager / KMS in production. Losing it makes PHI unrecoverable.
SUDS_ENCRYPTION_KEY=

# Separate key for blind-index search hashes (HMAC). Generate with: npm run gen-key
SUDS_INDEX_KEY=

# SQLite database path (should be on an encrypted volume)
SUDS_DB_PATH=./data/suds.db

# TLS (strongly recommended; required for HIPAA transmission security unless behind a TLS-terminating proxy)
TLS_CERT_PATH=
TLS_KEY_PATH=

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For (so audit logs record the real client IP)
TRUST_PROXY=0

# Session policy (minutes)
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12

# Require MFA for these roles (comma separated). Default: admin,supervisor
MFA_REQUIRED_ROLES=admin,supervisor

# Microsoft Graph (OneNote import). Register an app in Entra ID with Notes.Read.All (application) permission.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The user principal (UPN) whose OneNote notebooks should be imported, e.g. navigator@county.gov
MS_ONENOTE_USER=

# Audit log retention (days). HIPAA requires 6 years for policies/records; audit logs default to 7 years.
AUDIT_RETENTION_DAYS=2555
