# One SUDS tenant (Option A: its own Lightsail VM). Copy to $FLEET_HOME/tenants/<slug>.env in the PRIVATE ops
# directory, never into this repository (the scripts refuse to read it from here). No secrets in this file: the
# Porkbun key, the SSH key and the escrow are separate files under FLEET_HOME. deploy/fleet/README.md is the runbook.
# KEY=value lines only; the scripts read them, they never run them.

# The tenant: lowercase letters, digits and hyphens. It names everything: suds-<slug> (instance), suds-<slug>-ip,
# suds-<slug>-data / -offsite / -anchors (disks), register/<slug>.env, escrow/<slug>/.
TENANT_SLUG=drill
# The name staff open. Default <slug>.suds.systems (DNS at Porkbun, automatic). A county's own domain on request:
# then DNS is the county's, and the run prints the A record to create and waits until DNS-over-HTTPS shows it.
TENANT_DOMAIN=
DNS_ZONE=suds.systems
# yes: www.<domain> answers with a permanent redirect to <domain> (install.sh --www-redirect), with its own A record.
WWW_REDIRECT=no
# The only networks SSH is allowed from, IPv4 and IPv6 (Lightsail firewall and ufw). Run the scripts from inside them.
ADMIN_CIDR=203.0.113.10/32
ADMIN_CIDR6=2001:db8:10::/48
# Contact for the Let's Encrypt account (optional).
ACME_EMAIL=

# AWS Lightsail (aws lightsail get-bundles / get-regions). The $24 dual-stack plan ran suds.systems at launch.
REGION=us-west-2
AVAILABILITY_ZONE=us-west-2a
LIGHTSAIL_BUNDLE=medium_3_0
LIGHTSAIL_BLUEPRINT=ubuntu_24_04
LIGHTSAIL_KEY_PAIR=suds-fleet
SSH_USER=ubuntu

# The SUDS release, pinned per tenant. RELEASE_SHA256 from the GitHub Release notes AND the version's CHANGELOG
# section on main (they must agree); the zip is downloaded once into FLEET_HOME and checked before every use.
SUDS_VERSION=1.25.3
RELEASE_SHA256=
RELEASE_ZIP=releases/suds-v1.25.3.zip

# Block disks in GB; the three sizes must differ (the VM tells them apart by size). The data disk becomes the LUKS2
# volume at /var/lib/suds; 0 = no data disk, data on the unencrypted root disk (only with --allow-unencrypted-demo).
DATA_DISK_GB=64
OFFSITE_DISK_GB=32
ANCHORS_DISK_GB=8

# Private paths, relative to FLEET_HOME (refused outside it). The register is FLEET_HOME/register, the escrow
# FLEET_HOME/escrow (access log: FLEET_HOME/escrow/access.log), SSH host keys FLEET_HOME/known_hosts.
SSH_KEY_FILE=keys/suds-fleet.pem
PORKBUN_CREDENTIALS=credentials/porkbun.env
# The owner's escrow key (gpg): its full 40-hex fingerprint. Its public half in the operator's keyring; its private
# half held by the owner, offline. The keys are encrypted to it before they reach this machine's disk.
ESCROW_GPG_RECIPIENT=
