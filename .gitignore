node_modules/
data/
!data/.gitkeep
.env
*.db
*.db-journal
*.db-wal
*.db-shm
backups/
certs/

# Android release signing. The keystore IS the app's identity: committing it would let anyone publish an
# update county phones would accept, and losing it means staff must uninstall to upgrade.
android-signing/
*.jks
*.keystore
SUDS_KEYSTORE_BASE64.txt

# Build output of scripts/build-static-site.js — generated, published to gh-pages by CI, never committed here.
/_site/

# Provider pictures downloaded by scripts/fetch-region-pictures.js for the static build: other
# organisations' logos and photos, refreshed at each build, never committed (docs/WEB_APP.md).
/_region-pictures/
